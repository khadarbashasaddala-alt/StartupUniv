# Trivy ignore file — false positives for this project
# Format: CVE-ID  # reason

# CVE-2024-24790 — golang net/netip in esbuild binary (node_modules/vite/@esbuild/linux-x64)
# esbuild is a BUILD-TIME tool only (used by Vite during npm run build).
# It is not executed at runtime in production. Safe to ignore.
CVE-2024-24790

# CVE-2025-68121 — golang crypto/tls in esbuild binary (node_modules/vite/@esbuild/linux-x64)
# Same reason as above — esbuild build tool, not a runtime dependency.
CVE-2025-68121

# CVE-2025-27152 — axios SSRF vulnerability (transitive dep via @sendgrid/mail and razorpay)
# Trivy reports fix requires axios 1.15.9+, but that version is not yet published on npm.
# Mitigated by overriding to latest available (1.15.0) via package.json overrides.
# Remove this ignore once axios >=1.15.9 is available on npm and lock file is updated.
CVE-2025-27152
