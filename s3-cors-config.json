{
  "CORSRules": [
    {
      "AllowedHeaders": [
        "*"
      ],
      "AllowedMethods": [
        "GET",
        "PUT",
        "POST",
        "HEAD",
        "DELETE"
      ],
      "AllowedOrigins": [
        "*",
        "http://localhost:5000",
        "http://localhost:5432",
        "http://localhost:3000",
        "https://www.startupvarsity.com",
        "https://startupvarsity.com",
        "https://startupvarsity.rooman.net",
        "http://www.startupvarsity.com",
        "http://startupvarsity.com"
      ],
      "ExposeHeaders": [
        "ETag",
        "x-amz-server-side-encryption",
        "x-amz-request-id",
        "x-amz-id-2"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}

