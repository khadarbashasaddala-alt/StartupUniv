# Copy this file to .env and fill in the real values.
#
#   cp .env.example .env
#
# Ask a teammate for anything marked <ask-a-teammate>. Never commit .env --
# it is gitignored and holds live credentials.

# AWS credentials (used by the S3 upload features)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=<ask-a-teammate>
AWS_SECRET_ACCESS_KEY=<ask-a-teammate>

# google calendar credentials
GOOGLE_CALENDAR_CLIENT_ID=<ask-a-teammate>
GOOGLE_CALENDAR_CLIENT_SECRET=<ask-a-teammate>
GOOGLE_CALENDAR_REFRESH_TOKEN=<ask-a-teammate>
GOOGLE_CALENDAR_ID=primary

# ==========================================
# DATABASE
# ==========================================
# Local dev talks to the shared dev RDS instance "startupvarsity-local"
# (ap-south-1) through an SSM tunnel. That instance is not publicly
# accessible, so a direct connection will just time out.
#
# In a separate terminal, before starting the app:
#
#   ./scripts/db-tunnel.sh
#
# Leave it running. Then DATABASE_URL below points at the tunnel.
DATABASE_NAME=postgres
DATABASE_USER=startupvarsity
DATABASE_PASSWORD=<ask-a-teammate>
DATABASE_HOST=127.0.0.1
PORT=5000

DATABASE_URL=postgresql://startupvarsity:<ask-a-teammate>@127.0.0.1:5544/postgres?sslmode=require

# Direct endpoint -- only resolves from inside the VPC (or on VPN):
#DATABASE_URL=postgresql://startupvarsity:<password>@startupvarsity-local.cvpkcfi2aqhq.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require

# Email notification for the candidates
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=<ask-a-teammate>
SENDGRID_API_KEY=<ask-a-teammate>
DEFAULT_FROM_EMAIL=hello@startupvarsity.com

# S3 bucket
AWS_S3_BUCKET_NAME=startupvarsity-portal-files-829408051205

# portal link
APP_URL=http://localhost:5000
PORTAL_URL=http://localhost:5000

# ==========================================
# KEYCLOAK SSO CONFIGURATION
# ==========================================
# sso.startupvarsity.com restricts inbound traffic by IP, so SSO discovery
# will time out from an unlisted network. The server logs the failure and
# keeps running -- regular (non-SSO) login still works. Set ENABLE_SSO=false
# to skip the 3.5s startup delay entirely.
KEYCLOAK_ISSUER=https://sso.startupvarsity.com/realms/startupvarsity
KEYCLOAK_CLIENT_ID=startupvarsity-app
KEYCLOAK_CLIENT_SECRET=<ask-a-teammate>
KEYCLOAK_REDIRECT_URI=http://localhost:5000/api/auth/callback
KEYCLOAK_ADMIN_USERNAME=<ask-a-teammate>
KEYCLOAK_ADMIN_PASSWORD=<ask-a-teammate>

# ==========================================
# MOODLE (LMS) OAUTH2/OIDC CONFIGURATION
# ==========================================
MOODLE_BASE_URL=https://learn.rooman.com
MOODLE_OAUTH2_START_URL=https://learn.rooman.com/auth/oauth2/

KEYCLOAK_URL=https://sso.startupvarsity.com
KEYCLOAK_REALM=startupvarsity
MOODLE_CLIENT_ID=moodle-rooman
MOODLE_REDIRECT_URI=https://learn.rooman.com/admin/oauth2callback.php
MOODLE_WEB_ORIGIN=https://learn.rooman.com

# ==========================================
# SESSION CONFIGURATION
# ==========================================
# Any long random string works locally: openssl rand -hex 32
SESSION_SECRET=<generate-your-own>
SESSION_SECURE=false
SESSION_MAX_AGE=86400000

# ==========================================
# SSO FEATURE FLAGS
# ==========================================
ENABLE_SSO=true
ALLOW_LEGACY_LOGIN=true
AUTO_MIGRATE_USERS=true

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Use TEST keys locally (rzp_test_...), never the live ones.
RAZORPAY_KEY_ID=<ask-a-teammate>
RAZORPAY_KEY_SECRET=<ask-a-teammate>
# RAZORPAY_WEBHOOK_SECRET=

# Payment Configuration
DEFAULT_REGISTRATION_FEE=10000
MAX_PAYMENT_AMOUNT=400000
MIN_PAYMENT_AMOUNT=1
PAYMENT_RETRY_LIMIT=2
PAYMENT_RETRY_COOLDOWN=3600
OFFER_EXPIRY_HOURS=24

# GST Configuration
GST_RATE=18
GST_INCLUSIVE=true
COMPANY_NAME=StartupVarsity
COMPANY_ADDRESS=India
# COMPANY_GST_NUMBER=
COMPANY_PHONE=8045888899
COMPANY_EMAIL=hello@startupvarsity.com

# Production URL
PRODUCTION_URL=https://www.startupvarsity.com

# ==========================================
# CHATBOT MICROSERVICE (bot/)
# ==========================================
OPENAI_API_KEY=<ask-a-teammate>
BOT_PORT=4001

# Disables TLS certificate verification process-wide. Only needed because the
# RDS certificate chain is not bundled; see readme "Local Development Setup".
NODE_TLS_REJECT_UNAUTHORIZED=0

# ==========================================
# CONVEX (file / image / video storage)
# ==========================================
# Deployment URLs from the Convex dashboard. CONVEX_URL is the function API
# (queries and mutations); CONVEX_SITE_URL serves public media over HTTP.
CONVEX_URL=https://shiny-cheetah-636.eu-west-1.convex.cloud
CONVEX_SITE_URL=https://shiny-cheetah-636.eu-west-1.convex.site
#
# Convex functions are reachable from any browser that knows the deployment
# URL, so the media functions only answer callers that present this secret --
# which means the Express server and nothing else. It must be set in BOTH
# places, to the same value:
#   1. here, and
#   2. on the deployment:  npx convex env set CONVEX_SERVICE_SECRET <value>
# Generate one with: openssl rand -hex 32
CONVEX_SERVICE_SECRET=<ask-a-teammate>
