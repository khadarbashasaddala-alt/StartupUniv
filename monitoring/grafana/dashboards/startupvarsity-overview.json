      "targets": [
        { "expr": "sum(rate(user_registrations_total{job=\"startupvarsity-portal\"}[5m])) * 60", "legendFormat": "Registrations/min" },
        { "expr": "sum(rate(user_logins_total{job=\"startupvarsity-portal\",status=\"success\"}[5m])) * 60", "legendFormat": "Logins/min" }
