      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "nodejs_heap_size_used_bytes{job=\"startupvarsity-portal\"} / 1024 / 1024", "legendFormat": "Heap Used" },
        { "expr": "nodejs_heap_size_total_bytes{job=\"startupvarsity-portal\"} / 1024 / 1024", "legendFormat": "Heap Total" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Event Loop Lag (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "nodejs_eventloop_lag_seconds{job=\"startupvarsity-portal\"} * 1000", "legendFormat": "Event Loop Lag" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }, { "color": "red", "value": 500 }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Active Handles & Requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "nodejs_active_handles_total{job=\"startupvarsity-portal\"}", "legendFormat": "Active Handles" },
        { "expr": "nodejs_active_requests_total{job=\"startupvarsity-portal\"}", "legendFormat": "Active Requests" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "GC Duration (p99 by type)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(nodejs_gc_duration_seconds_bucket{job=\"startupvarsity-portal\"}[5m]))", "legendFormat": "GC p99 {{ kind }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } } }
    },

    {
